# Telegram bot token from @BotFather
BOT_TOKEN=

# Database. SQLite for local testing, PostgreSQL for production:
#   postgresql+asyncpg://user:password@localhost:5432/walletbot
DATABASE_URL=sqlite+aiosqlite:///./walletbot.db

# 32-byte key, base64-encoded. Encrypts every user's private key.
# Generate with:  python -m bot.crypto
# NEVER commit this. Losing it means losing access to every user wallet.
MASTER_KEY=

# Use testnet until everything is tested.
NETWORK=testnet

# Optional sending caps in whole tokens: SYMBOL=per_transaction/per_24_hours.
# A token with no entry (for example tokens users add themselves) has no cap.
# These are arbitrary starting values: set them to what each token is worth.
SEND_LIMITS=GAS=50/200,NEO=100/500,NRP=1000000/5000000,FRANK=1000000/5000000

# EVM networks. A network is switched on by giving it an RPC URL (leave empty to
# disable). The bot checks at startup that the node reports the right chain id
# for NETWORK (mainnet: Neo X 47763, BSC 56, Ethereum 1, Polygon 137, Arbitrum 42161, Optimism 10,
# Base 8453, Avalanche 43114; testnet: Neo X 12227332, BSC 97, Ethereum Sepolia 11155111, ...)
# and disables the network if it doesn't. Use a reliable provider; free public
# nodes rate-limit and restrict eth_getLogs. An RPC can also be a COMMA-SEPARATED LIST:
# when a call fails on the first URL the next is tried, e.g.
#   BSC_RPC=https://bsc-rpc.publicnode.com,https://bsc-dataseed.binance.org
NEO_X_RPC=
BSC_RPC=
ETH_RPC=
POLYGON_RPC=
ARBITRUM_RPC=
OPTIMISM_RPC=
BASE_RPC=
AVALANCHE_RPC=

# Any other EVM chain, no code needed. One entry is  slug|Name|chain_id|SYMBOL|rpc_url
# and entries are separated by ;   Example (leave empty to add none):
#   EXTRA_EVM_CHAINS=linea|Linea|59144|ETH|https://your-linea-rpc;gnosis|Gnosis|100|XDAI|https://your-gnosis-rpc
# The chain id is used exactly as written (NETWORK does not change it).
EXTRA_EVM_CHAINS=

# Solana JSON-RPC endpoint (leave empty to keep Solana off). The free public one,
# https://api.mainnet-beta.solana.com, is rate limited and fine only for trying it out:
# for real use get a key from a provider (Helius, QuickNode, Alchemy...).
# NETWORK=mainnet uses Solana mainnet; NETWORK=testnet needs a Solana DEVNET endpoint.
SOLANA_RPC=
# Seconds between checks of all Solana wallets (default 120, minimum 10). Every wallet costs one request
# per check, so a free provider plan lasts longer with a bigger number. Deposits show up this much later.
SOLANA_POLL_SECONDS=120

# Group events (/rain and /quiz). Group admins can always start them. Optionally list extra Telegram user ids
# (numbers, comma-separated) that may start them in any group the bot is in. Leave empty for admins only.
EVENT_ADMINS=

# The Telegram @username behind the Support button in /help (without the @). Empty hides the button.
SUPPORT_USERNAME=aziz1683
# More people shown as Support buttons in Help (comma separated)
SUPPORT_EXTRA=btc_mahadi

# Neo N3 JSON-RPC node. It MUST run the RpcNep17Tracker plugin (balances and
# transfer history). Use a testnet node while NETWORK=testnet. Public nodes
# come and go; if balances show "unavailable", try another node or run your own.
NEO_N3_RPC=

# Optional: Bifinance's trading page for a coin, with {symbol} in it, used by the Trade page. Example:
# BIFINANCE_TRADE_URL=https://www.bifinance.com/trade/{symbol}_USDT

# Airdrops: the support user (SUPPORT_USERNAME, @aziz1683 by default) gets each new airdrop to approve before it is announced to
# every user. He must have opened the bot once. To add more approvers, list their Telegram ids (numbers, comma-separated).
# AIRDROP_ADMINS=
# Usernames (besides the support user) that approve airdrop announcements, comma-separated. Default: btc_mahadi
# AIRDROP_ADMIN_USERNAMES=btc_mahadi

# --- AI Assistant (Help -> AI Assistant, and in groups: @mention the bot or reply to it) ---
# It always works from the bot's own Help (free). Add a key to let Claude write the answers from that knowledge.
# Leave empty to use only the built-in answers. Never share this key.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_DAILY_LIMIT=80

# --- FREE AI for the AI Assistant (no credit card): get a key at aistudio.google.com (Gemini) or console.groq.com (Groq) ---
AI_API_KEY=
AI_PROVIDER=gemini
# AI_MODEL=            # optional; one model, or several separated by commas (tried in order)

# Hourly encrypted backup of walletbot.db, sent to Telegram. Choose a long password and
# WRITE IT DOWN somewhere safe (it is NOT the MASTER_KEY). Empty = backups off.
# Recipients must have pressed Start in the bot once.
BACKUP_PASSWORD=
# BACKUP_RECIPIENTS=aziz1683,btc_mahadi
# BACKUP_IDS=
# BACKUP_EVERY_MINUTES=60

# --- Optional extras (leave empty to switch off) ---
# Relay (relay.link) as a second bridge next to LI.FI. Get a key at relay.link.
RELAY_API_KEY=
# More reliable prices (CoinGecko demo key).
COINGECKO_API_KEY=
# Who receives the encrypted daily backups and the daily statistics (Telegram @usernames without @, or numeric ids).
BACKUP_RECIPIENTS=
BACKUP_IDS=
